package health

import (
	"context"
	"net/http"

	"{{.Module}}/internal/platform/respond"
)

type Checker func(context.Context) error

func Register(mux *http.ServeMux, checkers ...Checker) {
	checks := append([]Checker(nil), checkers...)
	mux.HandleFunc("GET /healthz", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusNoContent) })
	mux.HandleFunc("GET /readyz", func(w http.ResponseWriter, r *http.Request) {
		for _, check := range checks {
			if r.Context().Err() != nil || check(r.Context()) != nil {
				respond.Problem(w, http.StatusServiceUnavailable)
				return
			}
		}
		if r.Context().Err() != nil {
			respond.Problem(w, http.StatusServiceUnavailable)
			return
		}
		w.WriteHeader(http.StatusNoContent)
	})
}
